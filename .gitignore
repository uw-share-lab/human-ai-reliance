# OS / editors
.DS_Store

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node / Vercel
node_modules/
.vercel

# secrets — never commit (public repo)
.env
.env.*
!.env.example

# local Claude Code permissions — machine-specific
.claude/settings.local.json

# participant data — never commit (public repo)
post-study-analysis/raw/*
post-study-analysis/merged/*
post-study-analysis/backups/*
post-study-analysis/data/*
!post-study-analysis/raw/.gitkeep
!post-study-analysis/merged/.gitkeep
!post-study-analysis/backups/.gitkeep
!post-study-analysis/data/.gitkeep
# coding/ is default-deny: participant-derived coding artifacts; allowlist reviewed files explicitly
post-study-analysis/coding/*
!post-study-analysis/coding/engagement_rubric_literature.md

# data-derived/ — derived CSVs + scoring yaml, all trace back to participant data
post-study-analysis/data-derived/*transcript*
post-study-analysis/data-derived/messages_clean.csv
post-study-analysis/data-derived/prolific_to_response_mapping.csv
post-study-analysis/data-derived/hard_exclusions_test_participants.csv
post-study-analysis/data-derived/conversation_engagement_metrics.csv
post-study-analysis/data-derived/scoring*
post-study-analysis/data-derived/exclude_words*.csv
post-study-analysis/data-derived/threshold_*.csv

# outputs/ — model outputs derived from participant data (dir renamed from
# outputs_engagement_predictors/ + outputs_updated_directionalR_revisionFF/;
# previously only covered by the nested post-study-analysis/.gitignore — added
# here too for defense-in-depth)
post-study-analysis/outputs/
aita-data-analysis/data/
generating-explanations/data/
